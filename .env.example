# Copy to .env and fill in. .env is gitignored — never commit secrets.

# --- Vision LLM for automatic visual QA ---
# Two ways to reach the model; VISION_LLM_MODEL is required either way.
#
# 1) Direct endpoint (OpenAI Responses API with image input; Azure OpenAI
#    included) — used whenever VISION_LLM_ENDPOINT is set:
# https://<resource>.openai.azure.com/openai/responses?api-version=2025-04-01-preview
VISION_LLM_ENDPOINT=
VISION_LLM_API_KEY=
#
# 2) DIAL Core deployment — leave VISION_LLM_ENDPOINT unset and the model is
#    called at {DIAL_CORE_URL}/openai/deployments/{VISION_LLM_MODEL}/chat/
#    completions with DIAL credentials (caller headers first, DIAL_API_KEY
#    fallback — same resolution as file storage).
# api-version added to the vision call when the endpoint URL has none.
# Azure OpenAI and DIAL's Azure upstream both require it. The default
# works for the Responses API and for chat completions with images.
# An api-version inside VISION_LLM_ENDPOINT always wins.
#VISION_LLM_API_VERSION=2025-04-01-preview
#
# Force the backend when auto-detection isn't wanted: direct | dial
#VISION_LLM_PROVIDER=
# Model name (direct) / DIAL deployment name (dial); must accept image input
VISION_LLM_MODEL=
# Optional: cap slides sent per inspection (default 15)
#VISION_LLM_MAX_SLIDES=15

# Visual QA. When VISION_LLM_* is configured the server registers two tools —
# visual_inspect_slides and visual_repair_slides — which the orchestrating
# agent calls as often as it likes, on the whole deck or on individual slides.
# Set false to register neither and turn the feature off entirely.
#VISUAL_QA_ENFORCE=true
# Inspect/repair rounds per visual_repair_slides call (the tool can override
# it per call with max_iterations)
#VISUAL_QA_MAX_ITERATIONS=10
# Optional export gate: also inspect-and-repair the whole deck inside
# export_presentation/save_presentation when it was edited since its last
# passing inspection, so no unverified deck can leave the server. Off by
# default — QA is driven by the agent through the tools above.
#VISUAL_QA_EXPORT_GATE=false
# Export-gate only — if the deck still fails after all rounds:
#   report       - the export fails with the unresolved issue list (default)
#   export_as_is - ship the best-effort deck anyway
#VISUAL_QA_ON_UNRESOLVED=report
# Export-gate only — what to do when inspection itself cannot run
# (renderer/LLM down): block (default) or allow
#VISUAL_QA_ON_ERROR=block

# --- DIAL Core file storage (see README) ---
#DIAL_CORE_URL=
# auto (default): the end user's credentials from the incoming MCP request
#   first -> each export lands in that user's own bucket (requires the server
#   to be deployed under the DIAL host so Quick Apps attaches the user's
#   bearer); falls back to DIAL_API_KEY when no caller credentials arrive.
#   caller: incoming credentials only, no fallback. server: always
#   DIAL_API_KEY (shared bucket).
#DIAL_AUTH_MODE=auto
#DIAL_API_KEY=
#DIAL_UPLOAD_FOLDER=pptx-mcp
# Largest image add_image_from_dial_url will download and embed (megabytes).
# Generated 1024x1024 PNGs are ~1-2 MB, so the default leaves plenty of room.
#DIAL_IMAGE_MAX_MB=20

# --- Server transport ---
#PPT_MCP_TRANSPORT=http
#PPT_MCP_HOST=0.0.0.0
#PPT_MCP_PORT=8000
# Host-header allowlist for the HTTP transports (comma-separated hostnames).
# Default: dial-pptx-mcp.dial.svc.cluster.local (the standard in-cluster
# service name). Only listed hosts (plus localhost) are accepted; others get
# 421. Set to * to disable Host checking entirely.
#PPT_MCP_ALLOWED_HOSTS=dial-pptx-mcp.dial.svc.cluster.local

# --- Logging ---
# DEBUG | INFO (default) | WARNING | ERROR | CRITICAL. Every record is a
# single line on stderr, including tracebacks and uvicorn's own output.
# DEBUG adds per-tool-call argument summaries, render/LLM timings and
# per-repair-operation detail.
#LOG_LEVEL=INFO

# --- Rendering ---
# Path to the LibreOffice binary if not "soffice" on PATH
#SOFFICE_PATH=/usr/bin/soffice
