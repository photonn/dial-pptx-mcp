# Copy to .env and fill in. .env is gitignored — never commit secrets.

# --- Vision LLM for visual inspection (visual_inspect_presentation tool) ---
# Any endpoint speaking the OpenAI Responses API with image input works;
# for Azure OpenAI use the full URL including api-version, e.g.
# https://<resource>.openai.azure.com/openai/responses?api-version=2025-04-01-preview
VISION_LLM_ENDPOINT=
VISION_LLM_API_KEY=
# Model / Azure deployment name (must support image input)
VISION_LLM_MODEL=
# Optional: cap slides sent per inspection (default 15)
#VISION_LLM_MAX_SLIDES=15

# Automatic visual QA (on by default when VISION_LLM_* is configured):
# on export/save of a deck edited since its last passed inspection, the
# server internally inspects, repairs, and re-inspects it; only a deck that
# passes is exported.
#VISUAL_QA_ENFORCE=true
# Inspection/repair rounds before giving up (default 10)
#VISUAL_QA_MAX_ITERATIONS=10
# If the deck still fails after all rounds:
#   report       - the export fails with the unresolved issue list (default)
#   export_as_is - ship the best-effort deck anyway
#VISUAL_QA_ON_UNRESOLVED=report
# What to do when inspection itself cannot run (renderer/LLM down):
# block (default) or allow
#VISUAL_QA_ON_ERROR=block
# Expose visual_inspect_presentation as a standalone MCP tool (off by default)
#VISUAL_QA_EXPOSE_TOOL=false

# --- DIAL Core file storage (see README) ---
#DIAL_CORE_URL=
# caller (default): use only the end user's credentials from the incoming MCP
#   request -> each export lands in that user's own bucket (requires the
#   server to be deployed under the DIAL host so Quick Apps attaches the
#   user's bearer). auto: fall back to DIAL_API_KEY. server: always
#   DIAL_API_KEY (shared bucket - dev only).
#DIAL_AUTH_MODE=caller
#DIAL_API_KEY=
#DIAL_UPLOAD_FOLDER=pptx-mcp

# --- Server transport ---
#PPT_MCP_TRANSPORT=http
#PPT_MCP_HOST=0.0.0.0
#PPT_MCP_PORT=8000

# --- Rendering ---
# Path to the LibreOffice binary if not "soffice" on PATH
#SOFFICE_PATH=/usr/bin/soffice
